From ac1426dc2b329be4cf7a6d18a4526e092a942ec1 Mon Sep 17 00:00:00 2001
From: Linus Walleij <linusw@kernel.org>
Date: Mon, 19 Oct 2026 23:12:12 +0200
Subject: [PATCH] ARM: dts: broadcom: Supply the XG6846B watchdog clock

The BCM6846 watchdog runs at 50 MHz, as described by the vendor device
tree and watchdog driver. Without a clock, bcm7038_wdt falls back to
27 MHz, making watchdog timeouts expire earlier than requested.

Use the SoC's fixed 50 MHz clock for the existing watchdog node on the
Genexis XG6846B. This also gives the driver the correct maximum timeout
of 85 seconds.

Signed-off-by: Linus Walleij <linusw@kernel.org>

---
diff --git a/arch/arm/boot/dts/broadcom/bcm6846-genexis-xg6846b.dts b/arch/arm/boot/dts/broadcom/bcm6846-genexis-xg6846b.dts
index 1b85e382c70c..03aec380f516 100644
--- a/arch/arm/boot/dts/broadcom/bcm6846-genexis-xg6846b.dts
+++ b/arch/arm/boot/dts/broadcom/bcm6846-genexis-xg6846b.dts
@@ -70,6 +70,10 @@
 	cpu-release-addr = <0xff800568>;
 };
 
+&{/bus@ff800000/watchdog@480} {
+	clocks = <&osc50m>;
+};
+
 &gpio0 {
 	status = "okay";
 };
