+	load r13, r8, 0x2, MEM_EXT32
+	alu.add r13, r13, 12, 0, 0, 0
+	alu.add r13, r13, 4, 0, 0, 1
+	store r13, r8, 0x2, MEM_EXT32
+	movi r23, 0x0
