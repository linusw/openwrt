+	}
+[a-zA-Z_.][a-zA-Z_0-9.]* {
+		yylval.name = alloc(yyleng + 1);
+		memcpy(yylval.name, yytext, yyleng + 1);
+		return NAME;
+	}
+[:,=()+&|\n-]	return yytext[0];
+.		error("unexpected character: %s", yytext);
