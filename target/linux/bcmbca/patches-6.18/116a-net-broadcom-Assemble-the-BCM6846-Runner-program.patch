+# SPDX-License-Identifier: GPL-2.0-or-later
+# Copyright 2019 Broadcom Ltd.
+#
+# BCM6846 reduced SRAM Buffer Pool Manager (SBPM) Runner program.
+# Addresses are byte addresses.
+# Encoding forms and unresolved fields are documented in runner-asm/README.rst.
+# The explicit control operands preserve pipeline and peripheral behavior.
+#
+# The host initializes r16 with the task PC in its high half. Keep these
+# entry addresses stable until the context initialization is updated too.
+
+.const GLOBAL_REGS = 0x60
+.const DEBUG_REGS = 0x2c0
+.const TASK_INDEX = 0xec
+.const MEM32 = 0x02
+.const MEM64 = 0x03
+.const MEM_EXT32 = 0x16
+.const MEM_EXT64 = 0x17
+.const BR_DEBUG = 0x1103
+.const BR_FIFO_BUSY = 0x11d7
+.const JMP_VECTOR = 0x1400
+.const JMP_INIT_EXIT = 0x1004
+.const JMP_RECYCLE = 0x1000
+.const JMP_TASK = 0x1c00
+
+.assert_pc 0x0000
+reset_vector:
+	jump initialization, JMP_VECTOR
+	nop
+	nop
+
+.assert_pc 0x000c
+debug_vector:
+	jump debug_save, JMP_VECTOR
+	nop
+	nop
+
+.assert_pc 0x0018
+initialization:
+	ld32.abs r1, GLOBAL_REGS + 0x4
+	ld64.abs r2, GLOBAL_REGS + 0x8
+	op09 0x0, 0x0
+	ld64.abs r4, GLOBAL_REGS + 0x10
+	ld64.abs r6, GLOBAL_REGS + 0x18
