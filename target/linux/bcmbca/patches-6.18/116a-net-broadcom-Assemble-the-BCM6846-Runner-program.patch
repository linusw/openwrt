+	field.2b r9, r9, 0, 16, 0, 0
+	op08 0x400, 0x0
+	movi r8, 0x17
+	op33 0, 8, 9, 0, 3, 0
+	field.2b r13, r19, 0, 14, 0, 0
+	movi r12, 0x3fff
+	alu.sub r0, r13, 12, 8, 0, 0
+	jump initialization_done, JMP_INIT_EXIT
+	field.2a r13, r8, 0, 6, 14, 0
+	movi r12, 0x0
+	op08 0x400, 0x0
+	movi r8, 0x30
+	op33 0, 8, 12, 8, 6, 0
+
+.assert_pc 0x0064
+initialization_done:
+	op08 0x0, 0x0
+
+.assert_pc 0x0068
+debug_save:
+	st32.abs r0, DEBUG_REGS + 0x0
+	st32.abs r1, DEBUG_REGS + 0x4
+	st64.abs r2, DEBUG_REGS + 0x8
+	st64.abs r4, DEBUG_REGS + 0x10
