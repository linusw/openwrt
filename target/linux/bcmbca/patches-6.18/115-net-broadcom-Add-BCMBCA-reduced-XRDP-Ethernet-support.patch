From 8b0fad44c189da8bb39f5afbaf4d1dc6829b8c94 Mon Sep 17 00:00:00 2001
From: Linus Walleij <linusw@kernel.org>
Date: Tue, 13 Oct 2026 11:46:35 +0200
Subject: [PATCH] net: broadcom: Add BCMBCA reduced XRDP Ethernet support

Add support for the BCMBCA XRDP packet engine, initially for the five
UniMAC ports on BCM6846. Use Broadcom's reduced Runner program to
transfer packets through on-chip SRAM, with a shared polling worker
and per-port transmit queues. The SRAM Buffer Pool Manager (SBPM)
allocates and recycles 128-byte buffers, which are linked together
to hold larger packets.

The SRAM is dedicated to the XRDP datapath as a packet assembly
buffer, not general-purpose SRAM. SBPM manages its buffer ownership,
so it remains an XRDP resource rather than a generic SRAM pool.

Use SoC match data for the register layout, SRAM buffer and port counts,
Runner count and initialization program, SBPM source addresses and
packet table locations. Per-port data describes the MAC, MIB, BBH and
RGMII registers, transmit destination and completion counter. Vendor
implementations vary these locations and mappings across BCMBCA SoCs.
Match only the BCM6846 compatible: the packet descriptors use the GEN45
SBPM format, and other generations also require different packet APIs
or MAC support.

Use the PMB reset and clock providers to power up and reset the XRDP
group, then prepare and enable its clocks before accessing registers or
initializing the packet pool. Quiesce the datapath before releasing the
clocks on probe failure, removal and shutdown. Keep the firmware PLL
configuration.
Validate receive descriptors and buffer lists before releasing them,
and stop packet processing if an SBPM command fails in a way that
leaves buffer ownership uncertain.

Use phylink for the internal GMII PHYs and the external RGMII port.
Support DSA frame overhead and expose UniMAC packet and error counters
through ethtool.

Power up the shared BCM6846 QEGPHY block before attaching any internal
PHY. Follow the vendor reset, clock and power sequence while holding
the MDIO bus lock, preserve the discovered MDIO base address and enable
only the internal ports described in DT. The Broadcom PHY driver handles
subsequent per-PHY calibration. Hold RTNL when disconnecting PHYs during
probe failure and teardown.

Firmware must configure pin multiplexing and external PHYs before Linux
starts. Packet transfers use polling and CPU copies.

Signed-off-by: Linus Walleij <linusw@kernel.org>

---
diff --git a/drivers/net/ethernet/broadcom/Kconfig b/drivers/net/ethernet/broadcom/Kconfig
index 47e9ece4b37a..b159e7e21d01 100644
--- a/drivers/net/ethernet/broadcom/Kconfig
+++ b/drivers/net/ethernet/broadcom/Kconfig
@@ -68,6 +68,24 @@ config BCM63XX_ENET
 	  This driver supports the ethernet MACs in the Broadcom 63xx
 	  MIPS chipset family (BCM63XX).
 
+config BCMBCA_XRDP_ETH
+	tristate "Broadcom BCMBCA reduced XRDP Ethernet"
+	depends on ARCH_BCMBCA || COMPILE_TEST
+	depends on COMMON_CLK && OF && HAS_IOMEM
+	depends on RESET_CONTROLLER
+	select CLK_BCMBCA_PMB
+	select MFD_BCMBCA_PMB
+	select PHYLINK
+	select RESET_BCMBCA_PMB
+	help
+	  Ethernet support for the BCMBCA XRDP packet engine using Broadcom's
+	  reduced Runner program and on-chip packet SRAM. Currently supports
+	  BCM6846. Packet transfers use polling.
+	  Firmware must have configured pin multiplexing and external PHYs
+	  before Linux starts.
+
+	  The module will be called bcmbca_xrdp.
+
 config BCMGENET
 	tristate "Broadcom GENET internal MAC support"
 	depends on HAS_IOMEM
diff --git a/drivers/net/ethernet/broadcom/Makefile b/drivers/net/ethernet/broadcom/Makefile
index 10cc1c92ecfc..7f0d77ce0873 100644
--- a/drivers/net/ethernet/broadcom/Makefile
+++ b/drivers/net/ethernet/broadcom/Makefile
@@ -6,6 +6,7 @@
 obj-$(CONFIG_B44) += b44.o
 obj-$(CONFIG_BCM4908_ENET) += bcm4908_enet.o
 obj-$(CONFIG_BCM63XX_ENET) += bcm63xx_enet.o
+obj-$(CONFIG_BCMBCA_XRDP_ETH) += bcmbca_xrdp.o
 obj-$(CONFIG_BCMGENET) += genet/
 obj-$(CONFIG_BNX2) += bnx2.o
 obj-$(CONFIG_CNIC) += cnic.o
