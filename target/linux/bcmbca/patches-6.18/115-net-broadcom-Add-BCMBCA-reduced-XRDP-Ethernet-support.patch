+	{ 0x40d8270c, 0x000001ff }, { 0x40d82714, 0x00000200 }, { 0x40d82708, 0x00000200 },
+	{ 0x40d82704, 0x0000000c }, { 0x40d80990, 0x0000001f }, { 0x40d800b0, 0x7f1ff1ff },
+	{ 0x40d80130, 0x7f1ff1ff }, { 0x40d80430, 0x101a0000 }, { 0x40d804c0, 0x00001000 },
+	{ 0x40d80620, 0x00001fff }, { 0x40d80330, 0x00004191 }, { 0x40d82180, 0x0000000c },
+	{ 0x40d8218c, 0x0000000c }, { 0x40d82700, 0x0000000d }, { 0x40d8270c, 0x000001ff },
+	{ 0x40d82714, 0x00000200 }, { 0x40d82708, 0x00000200 }, { 0x40d82704, 0x0000000d },
+	{ 0x40d80990, 0x0000001f }, { 0x40d80520, 0x00000001 }, { 0x40d80604, 0x0000003f },
+	{ 0x40d80900, 0x00000001 }, { 0x40d80480, 0x00000028 }, { 0x40d804d0, 0x0000017f },
+	{ 0x40d804d8, 0x00000081 }, { 0x40d804d4, 0x0000017f }, { 0x40d804dc, 0x00000081 },
+	{ 0x40d80980, 0x00000100 }, { 0x40d80004, 0x000017df }, { 0x40d9403c, 0x00000003 },
+	{ 0x40d9443c, 0x00000003 }, { 0x40d9483c, 0x00000003 }, { 0x40d94c3c, 0x00000003 },
+	{ 0x40d9503c, 0x00000003 }, { 0x40d80000, 0x00000101 }, { 0x40100000, 0x00000307 },
