From 13e6a884aade6a07a97f6009617ca6557a0cecff Mon Sep 17 00:00:00 2001
From: Linus Walleij <linusw@kernel.org>
Date: Wed, 21 Oct 2026 00:14:42 +0200
Subject: [PATCH] net: dsa: mv88e6xxx: Add PCS support for the 88E6320

Provide PCS operations for the 88E6320 SerDes ports so that phylink can
configure the SFP link on the Genexis XG6846B.

Reuse the 88E6321 lane mapping and mv88e6352 PCS operations. This assumes
the 88E6320 uses the same Clause 22 fiber-page register layout and
internal MDIO addresses 0x0c and 0x0d. Rename the lane helper and address
constant to reflect their use by both 632x variants. Link state is
polled, as on the 88E6321.

Link: https://lore.kernel.org/netdev/20260528210310.1365858-4-fidan.aliyeva.ext@ericsson.com/
Signed-off-by: Linus Walleij <linusw@kernel.org>

---
diff --git a/drivers/net/dsa/mv88e6xxx/chip.c b/drivers/net/dsa/mv88e6xxx/chip.c
index 1c01f072585c..84e8639114e5 100644
--- a/drivers/net/dsa/mv88e6xxx/chip.c
+++ b/drivers/net/dsa/mv88e6xxx/chip.c
@@ -5209,10 +5209,14 @@ static const struct mv88e6xxx_ops mv88e6320_ops = {
 	.vtu_loadpurge = mv88e6352_g1_vtu_loadpurge,
 	.stu_getnext = mv88e6352_g1_stu_getnext,
 	.stu_loadpurge = mv88e6352_g1_stu_loadpurge,
+	.serdes_get_lane = mv88e632x_serdes_get_lane,
+	.serdes_get_regs_len = mv88e6352_serdes_get_regs_len,
+	.serdes_get_regs = mv88e6352_serdes_get_regs,
 	.gpio_ops = &mv88e6352_gpio_ops,
 	.avb_ops = &mv88e6352_avb_ops,
 	.ptp_ops = &mv88e6352_ptp_ops,
 	.phylink_get_caps = mv88e632x_phylink_get_caps,
+	.pcs_ops = &mv88e6352_pcs_ops,
 };
 
 static const struct mv88e6xxx_ops mv88e6321_ops = {
@@ -5263,7 +5267,7 @@ static const struct mv88e6xxx_ops mv88e6321_ops = {
 	.vtu_loadpurge = mv88e6352_g1_vtu_loadpurge,
 	.stu_getnext = mv88e6352_g1_stu_getnext,
 	.stu_loadpurge = mv88e6352_g1_stu_loadpurge,
-	.serdes_get_lane = mv88e6321_serdes_get_lane,
+	.serdes_get_lane = mv88e632x_serdes_get_lane,
 	.serdes_get_regs_len = mv88e6352_serdes_get_regs_len,
 	.serdes_get_regs = mv88e6352_serdes_get_regs,
 	.gpio_ops = &mv88e6352_gpio_ops,
diff --git a/drivers/net/dsa/mv88e6xxx/serdes.c b/drivers/net/dsa/mv88e6xxx/serdes.c
index 4a394d47923e..2568f5524480 100644
--- a/drivers/net/dsa/mv88e6xxx/serdes.c
+++ b/drivers/net/dsa/mv88e6xxx/serdes.c
@@ -241,7 +241,7 @@ void mv88e6352_serdes_get_regs(struct mv88e6xxx_chip *chip, int port, void *_p)
 	}
 }
 
-int mv88e6321_serdes_get_lane(struct mv88e6xxx_chip *chip, int port)
+int mv88e632x_serdes_get_lane(struct mv88e6xxx_chip *chip, int port)
 {
 	int lane = -ENODEV;
 	u8 cmode;
@@ -254,7 +254,7 @@ int mv88e6321_serdes_get_lane(struct mv88e6xxx_chip *chip, int port)
 	if (cmode == MV88E6XXX_PORT_STS_CMODE_100BASEX ||
 	    cmode == MV88E6XXX_PORT_STS_CMODE_1000BASEX ||
 	    cmode == MV88E6XXX_PORT_STS_CMODE_SGMII)
-		lane = port + MV88E6321_PORT0_LANE;
+		lane = port + MV88E632X_PORT0_LANE;
 
 	return lane;
 }
diff --git a/drivers/net/dsa/mv88e6xxx/serdes.h b/drivers/net/dsa/mv88e6xxx/serdes.h
index e8f254909d6b..5732d360011c 100644
--- a/drivers/net/dsa/mv88e6xxx/serdes.h
+++ b/drivers/net/dsa/mv88e6xxx/serdes.h
@@ -14,7 +14,7 @@
 
 struct phylink_link_state;
 
-#define MV88E6321_PORT0_LANE		0x0c
+#define MV88E632X_PORT0_LANE		0x0c
 
 #define MV88E6352_ADDR_SERDES		0x0f
 #define MV88E6352_SERDES_PAGE_FIBER	0x01
@@ -116,7 +116,7 @@ struct phylink_link_state;
 int mv88e6xxx_pcs_decode_state(struct device *dev, u16 bmsr, u16 lpa,
 			       u16 status, struct phylink_link_state *state);
 
-int mv88e6321_serdes_get_lane(struct mv88e6xxx_chip *chip, int port);
+int mv88e632x_serdes_get_lane(struct mv88e6xxx_chip *chip, int port);
 int mv88e6341_serdes_get_lane(struct mv88e6xxx_chip *chip, int port);
 int mv88e6352_serdes_get_lane(struct mv88e6xxx_chip *chip, int port);
 int mv88e6390_serdes_get_lane(struct mv88e6xxx_chip *chip, int port);
