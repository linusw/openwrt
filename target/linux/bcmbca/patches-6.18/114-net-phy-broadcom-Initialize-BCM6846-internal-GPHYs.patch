From ca36bd0456037e10eebe37b8d5a9e846e3a37db7 Mon Sep 17 00:00:00 2001
From: Linus Walleij <linusw@kernel.org>
Date: Mon, 19 Oct 2026 16:49:52 +0200
Subject: [PATCH] net: phy: broadcom: Initialize BCM6846 internal GPHYs

The BCM6846 internal GPHYs report PHY ID 0xae0251e1 and need the analog
and DSP calibration supplied by the vendor EGPHY driver.

Add a model-specific entry with a standard software reset and the
calibration sequence from phy_drv_6846_egphy.c. Enable automatic pair
crossover and Ethernet@Wirespeed after calibration. Use the existing
Broadcom expansion and RDB helpers under the MDIO bus lock, propagate
transaction failures and restore legacy register access on both success
and calibration errors.

The shared QEGPHY power and clock sequence remains with the Ethernet
controller and runs before per-PHY initialization. Together these
sequences establish gigabit links on all four XG6846B LAN ports after
direct CFE boot, as tested with the OpenWrt port.

Signed-off-by: Linus Walleij <linusw@kernel.org>

---
--- a/drivers/net/phy/broadcom.c
+++ b/drivers/net/phy/broadcom.c
@@ -1452,6 +1452,55 @@ static int bcm54811_read_status(struct p
 	return genphy_read_status(phydev);
 }
 
+static int bcm6846_config_init(struct phy_device *phydev)
+{
+	/* BCM6846 analog calibration. */
+	static const struct {
+		u16 reg;
+		u16 val;
+	} afe[] = {
+		{ 0x0028, 0x0c30 }, /* Enable the DSP clock */
+		{ 0x01e5, 0x0000 }, /* Disable AOF */
+		{ 0x01ea, 0x0bcc }, /* 1G AB symmetry current */
+		{ 0x01e4, 0x233f }, /* Low-pass filter bandwidth */
+		{ 0x01ec, 0xad40 }, /* RCAL offset: 112 to 100 ohms */
+		{ 0x0125, 0x091b }, /* Reduce master current by 4% */
+		{ 0x0152, 0x87f6 }, /* RX on tuning */
+		{ 0x0156, 0x017d }, /* EEE 100TX bandwidth */
+		{ 0x0166, 0x0015 }, /* FFE zero detection */
+		{ 0x00b0, 0x0010 }, /* Assert R_CAL/RC_CAL reset */
+		{ 0x00b0, 0x0000 }, /* Release R_CAL/RC_CAL reset */
+	};
+	int ret, restore, i;
+
+	/* Keep the RDB access mode and register selectors serialized. */
+	phy_lock_mdio_bus(phydev);
+	ret = __bcm_phy_write_exp(phydev, BCM54XX_EXP_REG7E, 0);
+	if (ret)
+		goto unlock;
+
+	for (i = 0; i < ARRAY_SIZE(afe); i++) {
+		ret = __bcm_phy_write_rdb(phydev, afe[i].reg, afe[i].val);
+		if (ret)
+			goto restore_legacy;
+	}
+
+	/* CORE_SHD18_111: automatic pair crossover and Ethernet@Wirespeed. */
+	ret = __bcm_phy_modify_rdb(phydev, 0x002f, 0,
+				   MII_BCM54XX_AUXCTL_MISC_FORCE_AMDIX |
+				   MII_BCM54XX_AUXCTL_SHDWSEL_MISC_WIRESPEED_EN);
+
+restore_legacy:
+	/* Restore legacy access even after a failed calibration write. */
+	restore = __bcm_phy_write_rdb(phydev, BCM54XX_RDB_REG0087,
+				      BCM54XX_ACCESS_MODE_LEGACY_EN);
+	if (!ret)
+		ret = restore;
+unlock:
+	phy_unlock_mdio_bus(phydev);
+	return ret;
+}
+
 static struct phy_driver broadcom_drivers[] = {
 {
 	PHY_ID_MATCH_MODEL(PHY_ID_BCM5411),
@@ -1737,6 +1786,15 @@ static struct phy_driver broadcom_driver
 	.config_intr    = bcm_phy_config_intr,
 	.handle_interrupt = bcm_phy_handle_interrupt,
 	.link_change_notify	= bcm54xx_link_change_notify,
+}, {
+	PHY_ID_MATCH_MODEL(PHY_ID_BCM68460),
+	.name		= "Broadcom BCM6846",
+	.flags		= PHY_IS_INTERNAL,
+	/* PHY_GBIT_FEATURES */
+	.soft_reset	= genphy_soft_reset,
+	.config_init	= bcm6846_config_init,
+	.suspend	= genphy_suspend,
+	.resume		= genphy_resume,
 } };
 
 module_phy_driver(broadcom_drivers);
@@ -1762,6 +1820,7 @@ static const struct mdio_device_id __may
 	{ PHY_ID_MATCH_MODEL(PHY_ID_BCM5395) },
 	{ PHY_ID_MATCH_MODEL(PHY_ID_BCM53125) },
 	{ PHY_ID_MATCH_MODEL(PHY_ID_BCM53128) },
+	{ PHY_ID_MATCH_MODEL(PHY_ID_BCM68460) },
 	{ PHY_ID_MATCH_MODEL(PHY_ID_BCM89610) },
 	{ }
 };
--- a/include/linux/brcmphy.h
+++ b/include/linux/brcmphy.h
@@ -57,6 +57,7 @@
 
 #define PHY_ID_BCM_CYGNUS		0xae025200
 #define PHY_ID_BCM_OMEGA		0xae025100
+#define PHY_ID_BCM68460			0xae0251e0
 
 #define PHY_BCM_OUI_MASK		0xfffffc00
 #define PHY_BCM_OUI_1			0x00206000
